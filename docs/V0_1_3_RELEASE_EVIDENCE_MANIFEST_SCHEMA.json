{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelforge.local/schemas/v0.1.3-release-evidence-manifest.json",
  "title": "ModelForge v0.1.3 Release Evidence Manifest",
  "description": "Structural schema only. It does not execute validation, access secrets, sign assets, create tags, or publish releases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "commit_sha", "application_version", "candidate_type", "gates", "approval", "security"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "application_version": {"type": "string", "minLength": 1},
    "candidate_type": {"enum": ["release-candidate", "release"]},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "evidence_refs", "redacted"],
        "properties": {
          "gate_id": {"enum": ["i1_migration", "i2_concurrency_events", "i3_control_plane_audit", "i4_lifecycle", "i5_desktop", "windows_signing_install", "linux_signing_install", "release_approval"]},
          "status": {"enum": ["not_run", "pending", "passed", "failed", "blocked"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "redacted": {"const": true},
          "executed_at_utc": {"type": ["string", "null"], "format": "date-time"},
          "operator": {"type": ["string", "null"], "minLength": 1},
          "notes": {"type": ["string", "null"], "maxLength": 2000}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_authorized", "approver", "approved_at_utc"],
      "properties": {
        "release_authorized": {"type": "boolean"},
        "approver": {"type": ["string", "null"]},
        "approved_at_utc": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contains_secrets", "contains_unredacted_payloads"],
      "properties": {
        "contains_secrets": {"const": false},
        "contains_unredacted_payloads": {"const": false}
      }
    }
  }
}
